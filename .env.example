# Kopieren nach .env und anpassen.
TIDEFRONT_PORT=8080
POSTGRES_PASSWORD=bitte-ein-langes-zufallspasswort
# Einladungscodes, Komma-getrennt; optional :Anzahl Nutzungen (Vorgabe 1). Wird bei jedem Start ergänzt.
INVITE_CODES=FREUNDE2026:10
# Admins (Spielernamen, Komma-getrennt). Leer: der zuerst registrierte Spieler wird Admin.
ADMIN_NAMES=
# Öffentliche Adresse der Instanz (Links in E-Mails, Absender-Kennung für Web-Push).
PUBLIC_URL=https://tidefront.metaluna9.i234.me
# Schlüssel für gespeicherte Geheimnisse (SMTP-Passwort), erzeugen mit: openssl rand -hex 32
# Ohne APP_SECRET bleibt der E-Mail-Versand abgeschaltet. Nach dem Ändern das SMTP-Passwort neu eingeben.
APP_SECRET=
# Optional: eigene VAPID-Schlüssel für Web-Push (sonst erzeugt migrate welche).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://tidefront.metaluna9.i234.me
# Secure-Flag des Sitzungs-Cookies: auto (nach X-Forwarded-Proto), true, false
COOKIE_SECURE=auto
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups
TZ=Europe/Berlin
