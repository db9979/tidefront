{
  "name": "tidefront",
  "private": true,
  "version": "0.28.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/game-core/test/**/*.test.ts\"",
    "test:server": "node --test --test-concurrency=1 \"packages/engine/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "node packages/game-core/sim/simulate.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "build:web": "npm run build -w @tidefront/web",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "dev:api": "node --watch apps/api/src/main.ts",
    "dev:worker": "node --watch apps/worker/src/main.ts",
    "dev:web": "npm run dev -w @tidefront/web",
    "e2e": "playwright test -c apps/web/e2e/playwright.config.ts",
    "e2e:stack": "node apps/web/e2e/stack.ts",
    "typecheck:e2e": "tsc -p apps/web/e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^11.0.0",
    "@fastify/websocket": "^11.3.7",
    "@trpc/server": "^11.31.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "iovalkey": "^0.4.0",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
